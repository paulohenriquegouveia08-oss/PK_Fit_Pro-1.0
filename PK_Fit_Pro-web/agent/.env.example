# Configurações do Agente PK Fit Pro

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Control ID (opcional)
CONTROL_ID_URL=http://192.168.1.100
CONTROL_ID_USER=admin
CONTROL_ID_PASS=admin

# Logging
LOG_LEVEL=info
NODE_ENV=development

# Agent
HEARTBEAT_INTERVAL=30000
COMMAND_POLL_INTERVAL=5000